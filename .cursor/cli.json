{
  "version": 1,
  "permissions": {
    "allow": [
      "Shell(./gradlew)",
      "Shell(ls)",
      "Shell(rg)",
      "Shell(find)",
      "Shell(file)",
      "Shell(wc)",
      "Shell(diff)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:branch*)",
      "Shell(git:add*)",
      "Shell(git:commit*)",
      "Shell(git:stash list*)",
      "Read(**/*.kt)",
      "Read(**/*.kts)",
      "Read(**/*.java)",
      "Read(**/*.xml)",
      "Read(**/*.toml)",
      "Read(**/*.md)",
      "Read(**/*.pro)",
      "Read(gradle.properties)",
      "Write(app/src/**)",
      "Write(core/**)",
      "Write(feature/**)",
      "Write(build-logic/**)",
      "Write(.ai/**)",
      "Write(.jack/context/**)"
    ],
    "deny": [
      "Shell(rm)",
      "Shell(rmdir)",
      "Shell(sudo)",
      "Shell(mv)",
      "Shell(chmod)",
      "Shell(chown)",
      "Shell(curl)",
      "Shell(wget)",
      "Shell(keytool)",
      "Shell(apksigner)",
      "Shell(jarsigner)",
      "Shell(git:push*)",
      "Shell(git:reset*)",
      "Shell(git:clean*)",
      "Shell(git:checkout*)",
      "Shell(git:rebase*)",
      "Shell(git:config*)",
      "Read(local.properties)",
      "Read(keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(.env*)",
      "Write(local.properties)",
      "Write(keystore.properties)",
      "Write(**/*.jks)",
      "Write(**/*.keystore)",
      "Write(.gitignore)",
      "Write(gradle/wrapper/**)",
      "Write(gradlew)",
      "Write(gradlew.bat)"
    ]
  }
}
